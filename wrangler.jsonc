{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dewpt",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  // explicit routing posture (deliberate, not defaulted): serve on workers.dev,
  // and give non-production versions preview URLs (Workers Builds PR previews)
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_DO", "class_name": "SessionDO" },
      { "name": "BOARD_DO", "class_name": "BoardDO" },
      { "name": "CLIENT_RATE_LIMIT", "class_name": "ClientRateLimitDO" },
      { "name": "ACCOUNT_BUDGET", "class_name": "AccountBudgetDO" }
    ]
  },
  // Migration tags are an append-only ledger: v1 is already applied in
  // production, so it is never edited. A new class gets a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["BoardDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ClientRateLimitDO", "AccountBudgetDO"] }
  ],
  "ai": { "binding": "AI", "remote": true },
  "observability": { "enabled": true },
  "vars": {
    "GEN_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EMBED_MODEL": "@cf/baai/bge-m3"
  }
}
