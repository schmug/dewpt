{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dewpt",
      "runtimeExecutable": "zsh",
      "runtimeArgs": [
        "-c",
        "source ~/.zshenv 2>/dev/null; export CLOUDFLARE_ACCESS_CLIENT_ID CLOUDFLARE_ACCESS_CLIENT_SECRET; exec npx wrangler dev --port 8787"
      ],
      "port": 8787
    },
    {
      "name": "dewpt-offline",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-offline.mjs", "8790"],
      "port": 8790
    },
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8788"],
      "port": 8788
    }
  ]
}
